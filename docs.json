              },
              {
                "group": "Codex",
                "pages": [
                  "en/agent-configuration/codex/model-support",
                  {
                    "group": "Environment setup",
                    "pages": [
                      "en/agent-configuration/codex/install/codex-cli"
                    ]
                  },
                  "en/agent-configuration/codex/configuration"
                ]
              },
              {
                "group": "OpenCode",
                "pages": [
                  "en/agent-configuration/opencode/model-support",
                  {
                    "group": "Environment setup",
                    "pages": [
                      "en/agent-configuration/opencode/install/opencode-cli"
                    ]
                  },
                  "en/agent-configuration/opencode/configuration"
                ]
              }
            ]
          },
          {
            "tab": "API reference",
            "pages": [
              "en/api-reference/introduction"
            ]
          }
        ]
      },
      {
        "language": "cn",
        "default": true,
