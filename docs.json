                    "pages": [
                      "cn/agent-configuration/claude-code/install/claude-cli"
                    ]
                  },
                  "cn/agent-configuration/claude-code/configuration"
                ]
              },
              {
                "group": "Codex",
                "pages": [
                  "cn/agent-configuration/codex/model-support",
